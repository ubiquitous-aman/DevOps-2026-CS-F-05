PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/placement_portal
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ---------- Email (for Forgot Password OTP) ----------
# If left blank, OTPs are printed to the server console instead of emailed —
# handy for local development/testing without a real mailbox.
# For Gmail: use an "App Password" (not your normal password) —
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Placement Portal <no-reply@placement.edu>"

